    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0430\u0443\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0441\u043F\u0435\u043A\u0442\u0440\u0430"
