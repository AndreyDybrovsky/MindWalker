  m_Name: 
  m_EditorClassIdentifier: 
  thoughts:
  - "\u0410 \u0432\u0434\u0440\u0443\u0433 \u044F \u043D\u0435 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u043B
    \u0443\u0442\u044E\u0433?"
  - "\u041D\u0430\u0434\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u0435\u0449\u0451 \u0440\u0430\u0437"
  - "\u0427\u0442\u043E \u0435\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E
    \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F?"
  - "\u041C\u043D\u0435 \u043D\u0430\u0434\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F"
  - "\u041F\u043E\u0447\u0435\u043C\u0443 \u044F \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B?"
  - "\u042D\u0442\u043E \u0432\u0441\u0451 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E"
  - "\u0412\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0432\u0435\u0434\u044C \u043D\u0435
    \u0442\u043E"
  - "\u041D\u0435\u043B\u044C\u0437\u044F \u0442\u0430\u043A \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C"
  - "\u041D\u0430\u0434\u043E \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u0442\u044C"
  - "\u0427\u0442\u043E \u0435\u0441\u043B\u0438 \u044F \u043E\u0448\u0438\u0431\u0441\u044F?"
  - "\u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u0438\u043D\u0430\u0447\u0435"
  - "\u0427\u0442\u043E-\u0442\u043E \u0442\u043E\u0447\u043D\u043E \u043D\u0435
    \u0442\u0430\u043A"
  - "\u0410 \u0432\u0434\u0440\u0443\u0433 \u044F \u0447\u0442\u043E-\u0442\u043E
    \u0437\u0430\u0431\u044B\u043B?"
  - "\u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
  - "\u0410 \u0432\u0434\u0440\u0443\u0433 \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u043E?"
  - "\u041D\u0435\u0442, \u0432\u0441\u0451 \u043D\u0435 \u0442\u0430\u043A"
