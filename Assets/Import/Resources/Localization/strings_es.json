    { "key": "scene.ocd.objective_0", "value": "Haz la cama" },
    { "key": "scene.ocd.objective_1", "value": "Gira los objetos a 45°" },
    { "key": "scene.OCD_Text0", "value": "Mañana. Tengo que salir a la calle: aún queda tanto por hacer…" },
    { "key": "scene.OCD_Text1", "value": "Atardecer. Otra vez en casa. Todo debe quedar alineado — en el ángulo correcto." },
    { "key": "scene.ocd.day1.morning.1.objective", "value": "Lávate los dientes" },
    { "key": "scene.ocd.day1.morning.1.caption", "value": "Tengo que picar algo antes del instituto" },
    { "key": "scene.ocd.day1.morning.2.objective", "value": "Desayuna" },
    { "key": "scene.ocd.day1.morning.2.caption", "value": "Vaya, hasta me sobra un poco de tiempo libre" },
    { "key": "scene.ocd.day1.morning.3.objective", "value": "Descansa antes de clase" },
    { "key": "scene.ocd.day1.morning.3.caption", "value": "Bueno, hay que salir — no puedo llegar tarde al instituto" },
    { "key": "scene.ocd.day1.morning.4.objective", "value": "Ve al instituto" },
    { "key": "scene.ocd.day1.morning.4.caption", "value": "Qué hambre tengo…" },
    { "key": "scene.ocd.day1.evening.1.objective", "value": "Cena" },
    { "key": "scene.ocd.day1.evening.1.caption", "value": "Tengo que hacer los deberes — si no, Dmitry Ivanovich me despedaza" },
    { "key": "scene.ocd.day1.evening.2.objective", "value": "Haz los deberes" },
    { "key": "scene.ocd.day1.evening.2.caption", "value": "Listo — por fin puedo dormir tranquilo" },
    { "key": "scene.ocd.day1.evening.3.objective", "value": "Acuéstate" },
    { "key": "scene.ocd.day1.evening.3.caption", "value": "No tengo ningunas ganas de levantarme" },
    { "key": "scene.ocd.day2.morning.1.objective", "value": "Haz la cama" },
    { "key": "scene.ocd.day2.morning.1.caption", "value": "Nunca en mi vida he hecho la cama, va siendo hora de acostumbrarme" },
    { "key": "scene.ocd.day2.morning.2.objective", "value": "Desayuna" },
    { "key": "scene.ocd.day2.morning.2.caption", "value": "Quizá debería ordenar el apartamento" },
    { "key": "scene.ocd.day2.morning.3.objective", "value": "Limpia la habitación" },
    { "key": "scene.ocd.day2.morning.3.caption", "value": "¡Mierda! ¡Voy a llegar tarde!" },
    { "key": "scene.ocd.day2.morning.4.objective", "value": "Ve a clase" },
    { "key": "scene.ocd.day2.morning.4.caption", "value": "Un día demasiado largo" },
    { "key": "scene.ocd.day2.evening.1.objective", "value": "Cena" },
    { "key": "scene.ocd.day2.evening.1.caption", "value": "Tengo que prepararme para el examen" },
    { "key": "scene.ocd.day2.evening.2.objective", "value": "Haz los deberes" },
    { "key": "scene.ocd.day2.evening.2.caption", "value": "Se me ha hecho tarde… si total había poco trabajo" },
    { "key": "scene.ocd.day2.evening.3.objective", "value": "Acuéstate" },
    { "key": "scene.ocd.day2.evening.3.caption", "value": "Me siento fatal" },
    { "key": "scene.ocd.day3.morning.1.objective", "value": "Haz la cama" },
    { "key": "scene.ocd.day3.morning.1.caption", "value": "Esto no es un piso, es una pesadilla" },
    { "key": "scene.ocd.day3.morning.2.objective", "value": "Come" },
    { "key": "scene.ocd.day3.morning.2.caption", "value": "¿Por qué está todo tan torcido?!" },
    { "key": "scene.ocd.day3.morning.3.objective", "value": "Ordena" },
    { "key": "scene.ocd.day3.morning.3.caption", "value": "Siempre está todo torcido" },
    { "key": "scene.ocd.day3.morning.4.objective", "value": "Coloca todo como debe" },
    { "key": "scene.ocd.day3.morning.4.caption", "value": "¿Por qué está todo tan mal...?" },
    { "key": "scene.ocd.day3.morning.5.objective", "value": "Sal" },
    { "key": "scene.ocd.day3.morning.5.caption", "value": "No puedo, ahí fuera está todo demasiado mal..." },
    { "key": "scene.ocd.day3.morning.6.objective", "value": "Acuéstate" },
    { "key": "scene.ocd.day3.morning.6.caption", "value": "Me voy a morir de hambre..." },
    { "key": "scene.ocd.day4.evening.1.objective", "value": "Come" },
    { "key": "scene.ocd.day4.evening.1.caption", "value": "La comida no sabe a nada… y ni siquiera quiero" },
    { "key": "scene.ocd.day4.evening.2.objective", "value": "Ordena" },
    { "key": "scene.ocd.day4.evening.2.caption", "value": "Otra vez está todo fuera de sitio… cuánto más" },
    { "key": "scene.ocd.day4.evening.3.objective", "value": "Ordena" },
    { "key": "scene.ocd.day4.evening.3.caption", "value": "No me quedan fuerzas..." },
    { "key": "scene.ocd.day4.evening.4.objective", "value": "Acuéstate" },
    { "key": "scene.ocd.day4.evening.4.caption", "value": "Esto no puede seguir así" },
    { "key": "scene.ocd.day4.evening.5.objective", "value": "Sal afuera" },
    { "key": "scene.ocd.day4.evening.5.caption", "value": "Me da miedo salir, ahí fuera está todo demasiado torcido" },
    { "key": "scene.ocd.day4.evening.6.objective", "value": "Olvídalo(?)" },
    { "key": "scene.ocd.day4.evening.6.caption", "value": "¡Al diablo con todo, quiero volver a vivir!" },
    { "key": "scene.ocd.day4.evening.7.objective", "value": "Sánate" },
    { "key": "scene.ocd.day4.evening.7.caption", "value": "" },
    { "key": "scene.ocd.day4.evening.fixall.1.caption", "value": "Me tiemblan las manos… pero lo arreglaré" },
    { "key": "scene.ocd.day4.evening.fixall.2.caption", "value": "Un poco más. No puedo parar ahora" },
    { "key": "scene.ocd.day4.evening.fixall.3.caption", "value": "Me da asco, pero me obligaré" },
    { "key": "scene.ocd.day4.evening.fixall.4.caption", "value": "Casi… solo no derrumbarme" },
