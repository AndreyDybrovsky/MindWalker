    { "key": "scene.ocd.objective_0", "value": "Make the bed" },
    { "key": "scene.ocd.objective_1", "value": "Rotate objects to a 45° angle" },
    { "key": "scene.OCD_Text0", "value": "Morning. I need to go outside — so much to do…" },
    { "key": "scene.OCD_Text1", "value": "Evening. Home again. Everything must be aligned — at just the right angle." },
    { "key": "scene.ocd.day1.morning.1.objective", "value": "Brush your teeth" },
    { "key": "scene.ocd.day1.morning.1.caption", "value": "I should grab a bite before college" },
    { "key": "scene.ocd.day1.morning.2.objective", "value": "Have breakfast" },
    { "key": "scene.ocd.day1.morning.2.caption", "value": "Hey, I've even got some free time left" },
    { "key": "scene.ocd.day1.morning.3.objective", "value": "Rest before class" },
    { "key": "scene.ocd.day1.morning.3.caption", "value": "Alright, time to head out — can't be late for college" },
    { "key": "scene.ocd.day1.morning.4.objective", "value": "Go to college" },
    { "key": "scene.ocd.day1.morning.4.caption", "value": "I'm so hungry…" },
    { "key": "scene.ocd.day1.evening.1.objective", "value": "Have dinner" },
    { "key": "scene.ocd.day1.evening.1.caption", "value": "I need to do my homework — or Dmitry Ivanovich will skin me alive" },
    { "key": "scene.ocd.day1.evening.2.objective", "value": "Do your homework" },
    { "key": "scene.ocd.day1.evening.2.caption", "value": "That's it — I can finally go to bed with a clear conscience" },
    { "key": "scene.ocd.day1.evening.3.objective", "value": "Go to bed" },
    { "key": "scene.ocd.day1.evening.3.caption", "value": "For the first time in years, I actually slept well" },
    { "key": "scene.ocd.day2.morning.1.objective", "value": "Make the bed" },
    { "key": "scene.ocd.day2.morning.1.caption", "value": "I wish I could just leave — anything but this" },
    { "key": "scene.ocd.day2.morning.2.objective", "value": "Have breakfast" },
    { "key": "scene.ocd.day2.morning.2.caption", "value": "Okay, life's not that bad — especially after a snack" },
    { "key": "scene.ocd.day2.morning.3.objective", "value": "Clean the room" },
    { "key": "scene.ocd.day2.morning.3.caption", "value": "Damn, I'm already late!" },
    { "key": "scene.ocd.day2.morning.4.objective", "value": "Go to class" },
    { "key": "scene.ocd.day2.morning.4.caption", "value": "I'm gonna pass out… need something to eat first" },
    { "key": "scene.ocd.day2.evening.1.objective", "value": "Have dinner" },
    { "key": "scene.ocd.day2.evening.1.caption", "value": "I'm sleepy, but if I don't do the work, I'm in trouble" },
    { "key": "scene.ocd.day2.evening.2.objective", "value": "Do your homework" },
    { "key": "scene.ocd.day2.evening.2.caption", "value": "How is it already 2 a.m.? I need sleep" },
    { "key": "scene.ocd.day2.evening.3.objective", "value": "Go to bed" },
    { "key": "scene.ocd.day2.evening.3.caption", "value": "I feel awful" },
    { "key": "scene.ocd.day3.morning.1.objective", "value": "Make the bed" },
    { "key": "scene.ocd.day3.morning.1.caption", "value": "Today's going to be rough…" },
    { "key": "scene.ocd.day3.morning.2.objective", "value": "Eat" },
    { "key": "scene.ocd.day3.morning.2.caption", "value": "Why isn't anything where it should be?" },
    { "key": "scene.ocd.day3.morning.3.objective", "value": "Tidy up" },
    { "key": "scene.ocd.day3.morning.3.caption", "value": "This isn't an apartment — it's a nightmare" },
    { "key": "scene.ocd.day3.morning.4.objective", "value": "Put everything in place" },
    { "key": "scene.ocd.day3.morning.4.caption", "value": "I should go to class…" },
    { "key": "scene.ocd.day3.morning.5.objective", "value": "Go outside" },
    { "key": "scene.ocd.day3.morning.5.caption", "value": "No, I can't. I want to stay home today" },
    { "key": "scene.ocd.day3.morning.6.objective", "value": "Go to bed" },
    { "key": "scene.ocd.day3.morning.6.caption", "value": "Safer at home. Tomorrow I'll have to go out again…" },
    { "key": "scene.ocd.day4.evening.1.objective", "value": "Eat" },
    { "key": "scene.ocd.day4.evening.1.caption", "value": "Food tastes like nothing. I don't even want it" },
    { "key": "scene.ocd.day4.evening.2.objective", "value": "Go to bed" },
    { "key": "scene.ocd.day4.evening.2.caption", "value": "I can't keep living like this" },
    { "key": "scene.ocd.day4.evening.3.objective", "value": "Get out" },
    { "key": "scene.ocd.day4.evening.3.caption", "value": "Scary to step outside — everything out there is crooked" },
    { "key": "scene.ocd.day4.evening.4.objective", "value": "Fix everything" },
    { "key": "scene.ocd.day4.evening.4.caption", "value": "I'm tired of this perfectionism" },
    { "key": "scene.ocd.day4.evening.5.objective", "value": "Heal" },
    { "key": "scene.ocd.day4.evening.5.caption", "value": "Enough. Time to let go" },
